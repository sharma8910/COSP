{
  "manifest_version": 3,
  "name": "Child Safety Browser Protection",
  "version": "0.1.0",
  "description": "Applies the parent’s website policies to this browser.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost:4000/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Child Safety Settings"
  }
}
